GEMINI_API_KEY=replace-with-your-gemini-api-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=replace-with-your-supabase-key
# Server-side key allowed to write line_sources and detection_logs (service_role).
# Never expose this key in the dashboard/browser.
SUPABASE_HISTORY_KEY=replace-with-your-supabase-service-role-key
CHANNEL_SECRET=replace-with-your-line-channel-secret
CHANNEL_ACCESS_TOKEN=replace-with-your-line-channel-access-token
