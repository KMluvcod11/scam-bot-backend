GEMINI_API_KEY=replace-with-your-gemini-api-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=replace-with-your-supabase-key
# Server-only sb_secret key (or legacy service_role key) for history writes.
# Never expose it in the browser, logs, or Git; prefer a separate key for this bot.
SUPABASE_HISTORY_KEY=replace-with-your-supabase-secret-key
CHANNEL_SECRET=replace-with-your-line-channel-secret
CHANNEL_ACCESS_TOKEN=replace-with-your-line-channel-access-token

# Optional Mini App: LINE Login channel must share the bot's Provider.
# Leave blank to keep the existing chat lesson button until setup is complete.
MINI_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
# Frontend origin only; no /mini path. For local UI tests: http://localhost:5173
MINI_WEB_ORIGIN=
SAFE_BROWSING_API_KEY=YOUR_API_KEY_HERE
